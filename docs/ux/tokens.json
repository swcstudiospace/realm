{
  "color": {
    "$type": "color",
    "background": {
      "primary": { "$value": "#ffffff", "$type": "color" }
    },
    "surface": {
      "secondary": { "$value": "#f3f4f6", "$type": "color" },
      "widget": { "$value": "#f9fafb", "$type": "color" },
      "advisory": { "$value": "#fef3c7", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#111827", "$type": "color" },
      "secondary": { "$value": "#374151", "$type": "color" },
      "muted": { "$value": "#4b5563", "$type": "color" }
    },
    "link": {
      "primary": { "$value": "#1d4ed8", "$type": "color" }
    },
    "status": {
      "success": { "$value": "#166534", "$type": "color" },
      "warning": { "$value": "#92400e", "$type": "color" },
      "error": { "$value": "#b91c1c", "$type": "color" }
    },
    "toggle": {
      "track-on": { "$value": "#166534", "$type": "color" }
    },
    "focus": {
      "ring": { "$value": "#2563eb", "$type": "color" }
    },
    "border": {
      "default": { "$value": "#4b5563", "$type": "color" },
      "advisory": { "$value": "#92400e", "$type": "color" }
    }
  },
  "space": {
    "$type": "dimension",
    "scale-1": { "$value": "4px" },
    "scale-2": { "$value": "8px" },
    "scale-3": { "$value": "12px" },
    "scale-4": { "$value": "16px" },
    "scale-6": { "$value": "24px" },
    "scale-8": { "$value": "32px" },
    "scale-12": { "$value": "48px" },
    "scale-16": { "$value": "64px" }
  },
  "type": {
    "$type": "dimension",
    "size": {
      "body": { "$value": "16px" },
      "small": { "$value": "14px" },
      "code": { "$value": "13px" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "base": { "$value": "0px" },
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  }
}
