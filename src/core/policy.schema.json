{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realm policy",
  "description": "Frozen policy schema (D-15). Exactly these keys; every object rejects unknown keys (D-12). Defaults are applied by src/contract/validate.ts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["advisory", "fail-closed"],
      "default": "fail-closed"
    },
    "workspaceRoots": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "credentialAllow": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "egressAllow": {
      "type": "array",
      "items": { "$ref": "#/$defs/egressRule" },
      "default": []
    },
    "shellEnabled": {
      "type": "boolean",
      "default": false
    },
    "startupBudgetMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000,
      "default": 200000
    },
    "toolQueueMs": {
      "type": "integer",
      "minimum": 1,
      "default": 2000
    },
    "capabilityTokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["off", "enforce"], "default": "enforce" },
        "ttlSeconds": { "type": "integer", "minimum": 60, "maximum": 86400, "default": 3600 },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "enum": ["omp", "claude", "opencode", "kilo", "codex", "copilot", "antigravity", "cursor", "windsurf", "augment", "trae", "qwen", "hermes", "codebuddy", "cline", "kimi", "kimi-code", "zcode", "pi", "muse-code", "prime-agent", "grok-build"]
          },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["daemon.attach", "fs.read", "fs.write", "fs.list", "exec.argv", "exec.shell"] }
          },
          "default": {}
        }
      },
      "default": {}
    }
  },
  "$defs": {
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
