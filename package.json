{
  "name": "agent-realm",
  "version": "0.0.0",
  "private": true,
  "bin": { "realm": "./dist/src/cli/main.js" },
  "omp": { "extensions": ["./dist/src/omp/extension.js"] },
  "description": "Realm: strict ESM TypeScript package",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.json && node --test \"dist/test/integration/*.test.js\"",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
