{
  "name": "agent-realm",
  "version": "0.2.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Spectrum Web Co/swcstudiospace",
  "description": "Realm: strict ESM TypeScript package",
  "keywords": [
    "realm",
    "ai",
    "agent",
    "sandbox",
    "podman",
    "mcp",
    "acp",
    "ultrathink",
    "ussr-stack"
  ],
  "homepage": "https://swcstudiospace.github.io/realm/",
  "bugs": {
    "url": "https://github.com/swcstudiospace/realm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swcstudiospace/realm.git"
  },
  "bin": {
    "realm": "./dist/src/cli/main.js"
  },
  "omp": {
    "extensions": [
      "./dist/src/omp/extension.js"
    ]
  },
  "files": [
    "adapters",
    "dist/src",
    "src/runtime/driver/proto",
    "src/core/policy.schema.json",
    "src/contract/tools.schema.json",
    "src/contract/session-record.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "licenses",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.json && node --test \"dist/test/integration/*.test.js\"",
    "build": "tsc -p tsconfig.json",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:docs": "node scripts/check/host-paths.mjs && node scripts/check/agents-sync.mjs",
    "check:mcp": "node scripts/check/mcp-smoke.mjs",
    "check:pack": "node scripts/check/pack-smoke.mjs",
    "check:image-digests": "node scripts/check/verify-image-digests.mjs",
    "build:image": "node scripts/image/build-image.mjs",
    "check:gates": "node scripts/check/gate-closure.mjs",
    "release:next": "node scripts/release/next-version.mjs",
    "release:sync": "node scripts/release/sync-version.mjs",
    "release:changelog": "node scripts/release/changelog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@rivet-dev/agentos-core": "0.4.4",
    "ajv": "8.20.0"
  }
}
